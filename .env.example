# Copy these SMS Alert settings into your local .env file.
# Keep DEV_MODE=false outside local development. Set APP_ENV=production before deployment.
APP_ENV=development
DEV_MODE=false
SMS_ALERT_API_KEY=replace-with-your-rotated-sms-alert-api-key
SMS_ALERT_SENDER_ID=YOUR_APPROVED_SENDER_ID
SMS_ALERT_OTP_MESSAGE=Your LMS verification code is {otp}. It expires in 5 minutes. Do not share it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REVIEW_REDIRECT_URL=https://example.com/reviews
# Set this to the public HTTPS address of the deployed LMS so scanned QR codes can open it.
PUBLIC_BASE_URL=
